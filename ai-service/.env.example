FLASK_HOST=127.0.0.1
FLASK_PORT=5001
INTERNAL_SERVICE_TOKEN=change-this-to-a-long-random-internal-token

# Storage
INDEX_STORAGE_PATH=./indexes
KEEP_ORIGINALS=false

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Retrieval
TOP_K=4
MIN_RELEVANCE=0.25

# LLM Configuration (Google Gemini)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=2048

# Conversation context turns
MAX_CONTEXT_TURNS=4
